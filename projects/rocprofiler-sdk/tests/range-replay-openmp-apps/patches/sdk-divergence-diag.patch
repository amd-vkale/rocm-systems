@@ -172,6 +173,37 @@ count_divergence(const host_range_state_t& host)
     auto divergent = uint64_t{0};
     for(size_t i = 0; i < host.agents.size(); ++i)
         divergent += digest::count_divergent(host.agents[i].exit_digests, digests[i]);
+    if(common::get_env("ROCPROF_RANGE_REPLAY_DIAG", false))
+    {
+        for(size_t i = 0; i < host.agents.size(); ++i)
+        {
+            const auto snap = kernel_replay::memory_snapshot::snap(host.agents[i].hsa_agent);
+            const auto& lhs = host.agents[i].exit_digests;
+            const auto& rhs = digests[i];
+            ROCP_WARNING << fmt::format("range replay diag: agent {} blocks={} exit_digests={} "
