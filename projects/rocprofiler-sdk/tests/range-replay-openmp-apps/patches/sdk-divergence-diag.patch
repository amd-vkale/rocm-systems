+                    b,
+                    snap.blocks[b].gpu_addr,
+                    snap.blocks[b].host_copy.size(),
+                    snap.blocks[b].from_tracker,
+                    in_entry);
+            }
+        }
+    }
     for(size_t i = 0; i < host.regions.size(); ++i)
         if(host.regions[i].exit_digest != digests.back()[i]) ++divergent;
     return divergent;
